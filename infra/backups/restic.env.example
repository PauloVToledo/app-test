# Este archivo se instala como /etc/taskflow/backup/restic.env con permisos 0600.
# El bucket debe estar fuera del VPS y dedicado a respaldos de PostgreSQL.
RESTIC_REPOSITORY=s3:https://s3.example.com/taskflow-production-backups/postgres
AWS_ACCESS_KEY_ID=REEMPLAZAR_CON_CREDENCIAL_DE_RESPALDO
AWS_SECRET_ACCESS_KEY=REEMPLAZAR_CON_SECRETO_DE_RESPALDO

# Opcional para proveedores S3 compatibles que lo requieran.
# AWS_DEFAULT_REGION=us-east-1
# RESTIC_PASSWORD_COMMAND no se usa: la contraseña se lee desde un archivo separado.

# Estos valores deben coincidir con el despliegue Compose, si se cambiaron.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
