{
    # Sólo conexiones desde rangos oficiales de Cloudflare pueden aportar la
    # IP del visitante. La lista se revisa en cada actualización de Caddyfile:
    # https://www.cloudflare.com/ips
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
        trusted_proxies_strict
    }
}

# Entrada pública única: TASKFLOW_DOMAIN se inyecta desde Docker Compose.
# Caddy se expone directamente en el VPS (80/443), gestiona ACME y redirige
# HTTP a HTTPS. No se usa Cloudflare Tunnel.
{$TASKFLOW_DOMAIN} {
    encode zstd gzip

    # HSTS se entrega exclusivamente en la respuesta HTTPS. Activarlo exige
    # que el dominio y sus subdominios estén ya estables y disponibles por TLS.
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"

    reverse_proxy frontend:80 {
        # Descarta cualquier cadena aportada por el cliente y transmite sólo
        # la IP que Caddy obtuvo de un peer Cloudflare confiable (o la IP TCP
        # directa cuando Cloudflare no está delante).
        header_up X-Forwarded-For {client_ip}
        header_up X-Real-IP {client_ip}
    }
}
