discovery.docker "taskflow" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "taskflow" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "taskflow" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.taskflow.targets
  forward_to       = [loki.process.taskflow.receiver]
  relabel_rules    = discovery.relabel.taskflow.rules
  refresh_interval = "5s"
}

loki.process "taskflow" {
  stage.static_labels {
    values = {
      stack = "taskflow",
    }
  }
  forward_to = [loki.write.taskflow.receiver]
}

loki.write "taskflow" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
