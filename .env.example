# Nombre DNS público que apunta a este servidor (sin http:// ni rutas).
# Antes de levantar el stack, copia este archivo a .env y sustituye el valor.
TASKFLOW_DOMAIN=tasks.example.com

# Protección contra abuso de la API (valores por defecto si se omiten).
MAX_REQUEST_BODY_BYTES=1048576
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCKOUT_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# Autenticación: access JWT corto y refresh tokens persistidos en PostgreSQL.
# Las contraseñas y la clave JWT se leen como secretos de Docker desde
# secrets/jwt_secret y secrets/postgres_password; no se definen aquí.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
JWT_ISSUER=taskflow
JWT_AUDIENCE=taskflow-web
