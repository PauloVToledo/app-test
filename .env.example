# Entrada pública única. Sustituye por un FQDN cuyo registro DNS A/AAAA
# apunte al VPS antes de iniciar Caddy.
TASKFLOW_DOMAIN=taskflow.example.com

MAX_REQUEST_BODY_BYTES=1048576
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCKOUT_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
JWT_ISSUER=taskflow
JWT_AUDIENCE=taskflow-web

# Sólo se usa con --profile observability. La contraseña de Grafana se monta
# desde secrets/grafana_admin_password; nunca se pone en este archivo.
GRAFANA_ADMIN_USER=admin
